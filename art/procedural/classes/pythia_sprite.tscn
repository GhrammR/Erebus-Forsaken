[node name="Hand"    type="Polygon2D" parent="Body/ArmLShoulder/ElbowPivot"]

; --- RIGHT ARM: shoulder + elbow pivots. StaffArm rides under the
;     hand so the hand actually GRIPS the staff. Shaft is HORIZONTAL,
;     gripped at middle (Pattern 1 — mid-grip): butt extends -x, orb
;     extends +x. Forward jab is driven by ArmRShoulder rotation
;     (Pattern 2), staff rotation stays at 0.
[node name="ArmRShoulder" type="Node2D" parent="Body"]
position = Vector2(9, -44)
[node name="UpperArm" type="Polygon2D" parent="Body/ArmRShoulder"]
[node name="ElbowPivot" type="Node2D" parent="Body/ArmRShoulder"]
position = Vector2(0, 10)
[node name="Forearm" type="Polygon2D" parent="Body/ArmRShoulder/ElbowPivot"]
[node name="Hand"    type="Polygon2D" parent="Body/ArmRShoulder/ElbowPivot"]
[node name="StaffArm" type="Node2D"   parent="Body/ArmRShoulder/ElbowPivot"]
position = Vector2(0, 10)
[node name="Shaft" type="Polygon2D" parent="Body/ArmRShoulder/ElbowPivot/StaffArm"]
[node name="Grip"  type="Polygon2D" parent="Body/ArmRShoulder/ElbowPivot/StaffArm"]
; Cosmetic skin-colored "left hand" wrapped around the upper shaft.
; Parented to the staff so it rotates with it; guarantees the
; two-handed grip reads visually regardless of where the left arm
; polygon actually ends up. The real left arm just needs to point
; toward this marker — game zoom does the rest.
[node name="LeftGrip" type="Polygon2D" parent="Body/ArmRShoulder/ElbowPivot/StaffArm"]
[node name="Orb"   type="Polygon2D" parent="Body/ArmRShoulder/ElbowPivot/StaffArm"]

