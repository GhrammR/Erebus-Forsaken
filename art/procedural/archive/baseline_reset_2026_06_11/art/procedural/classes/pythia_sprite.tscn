; --- Robe layers BEFORE arms so reaching arms render on top of the
;     violet fabric. Robe drapes from waist down (overlays hips +
;     thighs); Mantle hangs across the shoulders + chest.
[node name="Robe"   type="Polygon2D" parent="Body"]
[node name="Mantle" type="Polygon2D" parent="Body"]

; --- LEFT ARM: shoulder + elbow pivots ---
; --- LEFT ARM: free / off-hand. Reaches across the body to grip
;     the upper shaft at the LeftGrip cosmetic (IK-pinned at runtime).
[node name="ArmLShoulder" type="Node2D" parent="Body"]
position = Vector2(-9, -44)
[node name="UpperArm" type="Polygon2D" parent="Body/ArmLShoulder"]
[node name="ElbowPivot" type="Node2D" parent="Body/ArmLShoulder"]
position = Vector2(0, 10)
[node name="Forearm" type="Polygon2D" parent="Body/ArmLShoulder/ElbowPivot"]
[node name="Hand"    type="Polygon2D" parent="Body/ArmLShoulder/ElbowPivot"]

; --- RIGHT ARM: dominant / anchor. The staff itself is a body-level
;     object driven by StaffStances; both hands reach marker targets
;     on that object via IK, so catalog stances alter real geometry.
[node name="ArmRShoulder" type="Node2D" parent="Body"]
position = Vector2(9, -44)
[node name="UpperArm" type="Polygon2D" parent="Body/ArmRShoulder"]
[node name="ElbowPivot" type="Node2D" parent="Body/ArmRShoulder"]
position = Vector2(0, 10)
[node name="Forearm" type="Polygon2D" parent="Body/ArmRShoulder/ElbowPivot"]
[node name="Hand"    type="Polygon2D" parent="Body/ArmRShoulder/ElbowPivot"]
[node name="StaffArm" type="Node2D"   parent="Body"]
position = Vector2(0, -38)
; Lift the staff above the equipment overlays. EquipmentPaperdoll
; instantiates chest / legs overlays as direct children of Body
; (later in tree order than the arm chain), so without an explicit
; z_index the staff disappears behind the cuirass / robe trim when
; it crosses through them. z_index = 2 puts the whole staff subtree
; (Shaft / Grip / LeftGrip / Orb) on top of the body overlays.
z_index = 2
[node name="Shaft" type="Polygon2D" parent="Body/StaffArm"]
[node name="Grip"  type="Polygon2D" parent="Body/StaffArm"]
[node name="RightGripMarker" type="Marker2D" parent="Body/StaffArm"]
position = Vector2(6, 0)
; Cosmetic skin-colored "left hand" wrapped around the upper shaft.
; Parented to the staff so it rotates with it; the L arm is
; IK-pinned to land its hand polygon at this marker every frame.
[node name="LeftGrip" type="Polygon2D" parent="Body/StaffArm"]
; IK pin target for the L hand. Marker2D at the staff-local position
; where the LeftGrip cosmetic centroid sits (+11 along the shaft).
; HumanRig.apply_pins reads its global_position each frame.
[node name="LeftGripMarker" type="Marker2D" parent="Body/StaffArm"]
position = Vector2(-6, 0)
[node name="Orb"   type="Polygon2D" parent="Body/StaffArm"]

