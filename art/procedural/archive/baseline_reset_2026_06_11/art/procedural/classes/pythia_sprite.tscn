[node name="Neck"  type="Polygon2D" parent="Body"]
[node name="Head"  type="Polygon2D" parent="Body"]
[node name="Face"  type="Node2D"    parent="Body"]
[node name="EyeSocketL" type="Polygon2D" parent="Body/Face"]
[node name="EyeSocketR" type="Polygon2D" parent="Body/Face"]
[node name="EyeL"  type="Polygon2D" parent="Body/Face"]
[node name="EyeR"  type="Polygon2D" parent="Body/Face"]
[node name="Brow"  type="Polygon2D" parent="Body/Face"]
[node name="Mouth" type="Polygon2D" parent="Body/Face"]
